node_modules/

# Secrets — never, under any circumstances, in this repo.
# The live key lives in the session scratchpad at chmod 600, outside this tree.
*.key
*.pem
.env
.env.*
secrets/
**/openai.key
**/*apikey*
**/*api_key*

# Image-generation raw output is a BUILD INPUT, not an asset.
# Only palette-quantised, reviewed, committed data enters the build.
assets/raw/

# Claude Code local permission cache — can capture command strings verbatim.
.claude/settings.local.json

# npm
node_modules/
package-lock.json

# Reference screenshots for the discriminator: measurement and comparison ONLY.
# Never shipped, never sent to a generation API, never committed. No asset rips, ever.
critique/reference/
critique/discriminator/

# Throwaway probe captures. Named rounds (r0, r1, ...) are the record and ARE committed;
# probe rounds are scratch measurements taken between them.
critique/shots/probe*/

# Generated for publishing only: `node tools/artifact.js` rebuilds it from dist/index.html.
# Committing it would carry a second 900 KB copy of the game on every build.
dist/artifact.html
