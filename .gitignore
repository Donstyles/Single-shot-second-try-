node_modules/

# Secrets — never, under any circumstances, in this repo.
# The live key lives in the session scratchpad at chmod 600, outside this tree.
*.key
*.pem
.env
.env.*
secrets/
**/openai.key
**/*apikey*
**/*api_key*

# assets/raw/ USED TO BE IGNORED HERE, on the reasoning that generated output is a build input and
# only reviewed, quantised data belongs in the tree. That reasoning is wrong when the build input
# COST MONEY. Seven hundred and twenty-five of the project's nine hundred and thirty-two credits
# bought the meshes and the full-resolution textures under assets/raw, and because of this rule they
# existed on exactly one ephemeral container and nowhere else -- one reclaim from being gone, with
# no way to regenerate them without paying again.
#
# 187 MB is a large tree. It is much cheaper than the alternative.

# Claude Code local permission cache — can capture command strings verbatim.
.claude/settings.local.json

# npm
node_modules/
package-lock.json

# Reference screenshots for the discriminator: measurement and comparison ONLY.
# Never shipped, never sent to a generation API, never committed. No asset rips, ever.
critique/reference/
critique/discriminator/

# Throwaway probe captures. Named rounds (r0, r1, ...) are the record and ARE committed;
# probe rounds are scratch measurements taken between them.
critique/shots/probe*/

# Generated for publishing only: `node tools/artifact.js` rebuilds it from dist/index.html.
# Committing it would carry a second 900 KB copy of the game on every build.
dist/artifact.html
